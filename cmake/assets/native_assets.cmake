# Source-owned asset plans. Every output has one producer; no per-member shells.
function(hg_asset_array output)
    set(items)
    foreach(value IN LISTS ARGN)
        hg_asset_json_string(quoted "${value}")
        list(APPEND items "${quoted}")
    endforeach()
    list(JOIN items "," items)
    set(${output} "[${items}]" PARENT_SCOPE)
endfunction()

function(hg_asset_host_job group kind inputs outputs)
    hg_asset_array(input_json ${inputs})
    hg_asset_array(output_json ${outputs})
    hg_asset_array(arguments ${ARGN})
    set(job "{\"kind\":\"${kind}\",\"inputs\":${input_json},\"outputs\":${output_json},\"args\":${arguments}}")
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_${group}_JOBS "${job}")
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_${group}_OUTPUTS ${outputs})
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_${group}_INPUTS ${inputs})
    set_source_files_properties(${outputs} PROPERTIES GENERATED TRUE)
endfunction()

function(hg_asset_gfx input output)
    set(inputs "${input}")
    if(EXISTS "${input}.key")
        list(APPEND inputs "${input}.key")
    endif()
    hg_asset_host_job(graphics gfx "${inputs}" "${output}" nitrogfx "${input}" "${output}" ${ARGN})
endfunction()

function(hg_native_asset_data target kind work output_dir sources)
    foreach(source IN LISTS sources)
        get_filename_component(stem "${source}" NAME_WE)
        file(RELATIVE_PATH relative "${game_source}" "${source}")
        set(output "${output_dir}/${stem}.bin")
        hg_asset_json_string(source_json "${relative}")
        hg_asset_json_string(output_json "${output}")
        set_property(GLOBAL APPEND PROPERTY HG_ASSET_data_JOBS "{\"source\":${source_json},\"output\":${output_json}}")
        set_property(GLOBAL APPEND PROPERTY HG_ASSET_data_OUTPUTS "${output}")
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_data_INPUTS "${source}")
        set_source_files_properties("${output}" PROPERTIES GENERATED TRUE)
    endforeach()
endfunction()

function(hg_native_assets_finalize)
    foreach(group messages graphics data)
        get_property(jobs GLOBAL PROPERTY HG_ASSET_${group}_JOBS)
        get_property(outputs GLOBAL PROPERTY HG_ASSET_${group}_OUTPUTS)
        get_property(inputs GLOBAL PROPERTY HG_ASSET_${group}_INPUTS)
        list(REMOVE_DUPLICATES outputs)
        list(REMOVE_DUPLICATES inputs)
        # Internal outputs are scheduled by the batch compiler itself.
        # Ninja tracks only dependencies external to this batch.
        set(external_inputs ${inputs})
        list(REMOVE_ITEM external_inputs ${outputs})
        list(JOIN jobs ",\n" jobs)
        set(raw "${PROJECT_BINARY_DIR}/asset-plans/${group}.source.json")
        file(CONFIGURE OUTPUT "${raw}" CONTENT "{\"mode\":\"${group}\",\"jobs\":[${jobs}]}\n" @ONLY)
        if(NOT group STREQUAL "data")
            execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/compiler/assets/plan.py"
                --plan "${raw}" --prepare COMMAND_ERROR_IS_FATAL ANY)
            file(READ "${PROJECT_BINARY_DIR}/asset-plans/${group}.source.ordered.json" ordered)
            string(JSON jobs GET "${ordered}" jobs)
        else()
            set(jobs "[${jobs}]")
        endif()
        set(plan "${PROJECT_BINARY_DIR}/asset-plans/${group}.json")
        set(receipt "${PROJECT_BINARY_DIR}/asset-plans/${group}-receipt.json")
        set(report "${PROJECT_BINARY_DIR}/asset-plans/${group}-profile.json")
        set(mode "host")
        if(group STREQUAL "data")
            set(mode "data")
        endif()
        file(GENERATE OUTPUT "${plan}" CONTENT
            "{\"mode\":\"${mode}\",\"binary\":\"${PROJECT_BINARY_DIR}\",\"game\":\"${game_source}\",\"ntr\":\"${ntr_source}\",\"generated\":\"${PROJECT_BINARY_DIR}/generated/files\",\"catalogue\":\"${PROJECT_SOURCE_DIR}/compiler/assets/constants.json\",\"receipt\":\"${receipt}\",\"workers\":4,\"common\":[\"$<TARGET_FILE:PNG::PNG>\",\"$<TARGET_FILE:ZLIB::ZLIB>\"],\"jobs\":${jobs}}\n")
        add_custom_command(
            OUTPUT ${outputs}
            COMMAND $<TARGET_FILE:hg_asset_compiler> "${plan}" "${report}"
            DEPENDS hg_asset_compiler
                $<TARGET_FILE:hg_asset_compiler>
                "${plan}"
                "${PROJECT_SOURCE_DIR}/compiler/assets/constants.json"
                ${external_inputs}
            WORKING_DIRECTORY "${PROJECT_BINARY_DIR}"
            COMMENT "Generating declared ${group} assets"
            VERBATIM)
        add_custom_target(heartgold_asset_${group} DEPENDS ${outputs})
    endforeach()
    add_dependencies(heartgold_asset_messages hg_asset_trainer_gmm)
    add_dependencies(heartgold_msg_assets heartgold_asset_messages)
    add_dependencies(heartgold_asset_data heartgold_msg_assets)
    foreach(target heartgold_scr_seq_assets heartgold_move_script_assets heartgold_subscript_assets heartgold_zone_event_assets)
        add_dependencies(${target} heartgold_asset_data)
    endforeach()
    get_property(archives GLOBAL PROPERTY HG_ASSET_ARCHIVE_TARGETS)
    foreach(target IN LISTS archives)
        if(NOT target MATCHES "heartgold_(scr_seq|move_script|subscript|zone_event)_assets")
            add_dependencies(${target} heartgold_asset_graphics heartgold_asset_data)
        endif()
    endforeach()
    add_dependencies(heartgold_sound_archive_assets heartgold_asset_graphics)
endfunction()
cmake_language(DEFER CALL hg_native_assets_finalize)

function(hg_native_asset_record source output)
    file(RELATIVE_PATH relative "${game_source}" "${source}")
    hg_asset_json_string(source_json "${relative}")
    hg_asset_json_string(output_json "${output}")
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_data_JOBS "{\"source\":${source_json},\"output\":${output_json}}")
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_data_OUTPUTS "${output}")
    set_property(GLOBAL APPEND PROPERTY HG_ASSET_data_INPUTS "${source}")
    set_source_files_properties("${output}" PROPERTIES GENERATED TRUE)
endfunction()
