# main.lsf owns ARM9 source/image membership. SDK code is supplied by libntr;
# overlays and ARM assembly are inventoried, never silently merged into main.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${game_source}/main.lsf")
file(STRINGS "${game_source}/main.lsf" manifest)
set(game_sources)
set(inventory "group\tobject\timplementation\n")
foreach(line IN LISTS manifest)
    if(line MATCHES "^(Static|Overlay|Autoload) +([A-Za-z0-9_]+)")
        set(group "${CMAKE_MATCH_2}")
    elseif(line MATCHES "^[ \t]+Object +([^ \t]+)\\.o")
        set(object "${CMAKE_MATCH_1}")
        if(object MATCHES "^(src/|lib/NitroSystem/src/)" AND EXISTS "${game_source}/${object}.c")
            set(kind "original C")
            if(group STREQUAL "main")
                list(APPEND game_sources "${game_source}/${object}.c")
            endif()
        elseif(object MATCHES "^lib/NitroSDK/")
            set(kind "SDK: supplied separately by libntr; verify symbol coverage")
        elseif(EXISTS "${game_source}/${object}.cpp")
            set(kind "original C++: requires runtime/ABI review")
        elseif(EXISTS "${game_source}/${object}.s")
            set(kind "ARM assembly/data: not native C")
        elseif(EXISTS "${game_source}/${object}.c")
            set(kind "other original library C: requires separate runtime/ABI review")
        else()
            set(kind "generated by original build rules; inspect before linking")
        endif()
        string(APPEND inventory "${group}\t${object}.o\t${kind}\n")
    endif()
endforeach()
list(REMOVE_DUPLICATES game_sources)
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/arm9-sources.tsv" CONTENT "${inventory}" @ONLY)

# One guarded transformation, one output per original input. Headers retain their
# original include names; sources retain their original relative path and #line.
set(native_root "${PROJECT_BINARY_DIR}/native")
set(native_script "${CMAKE_CURRENT_LIST_DIR}/native_sources.py")
function(native_generate kind input output)
    add_custom_command(OUTPUT "${output}"
        COMMAND "${Python3_EXECUTABLE}" -B "${native_script}"
            --root "${game_source}" --kind "${kind}"
            --input "${input}" --output "${output}"
        COMMAND "${CMAKE_COMMAND}" -E touch_nocreate "${output}"
        DEPENDS "${native_script}" "${PROJECT_SOURCE_DIR}/cmake/native_coordinated.py" "${input}" ${ARGN}
        VERBATIM)
endfunction()

